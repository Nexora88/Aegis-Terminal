# AEGIS TERMINAL local configuration
# Copy to .env for local development. Never commit real credentials or tokens.

AEGIS_DATA_DIR=./data
AEGIS_DATABASE_URL=
AEGIS_COLLECT_INTERVAL=15
AEGIS_LOG_RETENTION_DAYS=90

# Optional lawful open-data adapters
AEGIS_OPENSKY_URL=https://opensky-network.org/api/states/all
AEGIS_AIS_TOKEN=

# Optional SIEM/Syslog export
AEGIS_SYSLOG_HOST=
AEGIS_SYSLOG_PORT=514
